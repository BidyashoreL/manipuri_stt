{
  "data_root": ".",
  "audio_folder": "../benchmark",
  "csv_path": "../benchmark/ground_truth.csv",
  "output_dir": "../output_wav2vec_qwen",
  "train_csv": "train.csv",
  "val_csv": "val.csv",
  "test_csv": "test.csv",
  "checkpoint_dir": "checkpoints",
